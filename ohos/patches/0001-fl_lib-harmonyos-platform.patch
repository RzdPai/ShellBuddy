diff --git a/lib/src/core/utils/platform/arch.dart b/lib/src/core/utils/platform/arch.dart
index 9f6049f..311e6a8 100644
--- a/lib/src/core/utils/platform/arch.dart
+++ b/lib/src/core/utils/platform/arch.dart
@@ -65,6 +65,17 @@ enum CpuArch {
         return _fromUname();
       case Pfs.linux || Pfs.android || Pfs.fuchsia:
         return _fromUname();
+      case Pfs.ohos:
+        // Devices are arm64 and the emulator can be x64, so `uname` is asked
+        // first. It falls back rather than throwing: HarmonyOS runs the app
+        // in a sandbox that may refuse to spawn a process at all, and a wrong
+        // guess about the CPU costs one download the user can pick again —
+        // an exception here costs the launch.
+        try {
+          return _fromUname();
+        } catch (_) {
+          return CpuArch.arm64;
+        }
       case Pfs.web || Pfs.unknown:
         throw UnsupportedError('Unsupported platform: ${Pfs.type}');
     }
diff --git a/lib/src/core/utils/platform/base.dart b/lib/src/core/utils/platform/base.dart
